fn abs(x: i32) -> i32 {
    if x < 0 {
        return -x;
    }
    return x;
}

fn max(x: i32, y: i32) -> i32 {
    if (x > y) {
        return x;
    }
    return y;
}

fn min(x: i32, y: i32) -> i32 {
    if (x < y) {
        return x;
    }
    return y;
}

fn pow(base: i32, exp: i32) -> i32 {
    let result: i32 = 1;
    for i in 0..(exp) {
        result = result * base;
    }
    return result;
}

fn sum_to(n: i32) -> i32 {
    let s: i32 = 0;
    let i: i32 = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn clamp(val: i32, lo: i32, hi: i32) -> i32 {
    if (val < lo) {
        return lo;
    }
    if (val > hi) {
        return hi;
    }
    return val;
}
