fn kare(x: i32) -> i32 {
      return x * x;
  }

  fn topla(a: i32, b: i32) -> i32 {
      return a + b;
  }

  fn main() -> i32 {
      let sonuc: i32 = topla(3, 4);
      print(sonuc);

      let k: i32 = kare(5);
      print(k);

      let x: i32 = (1 + 2) * 3;
      print(x);

      for i in 0..5 {
          print(i);
      }

      return 0;
  }