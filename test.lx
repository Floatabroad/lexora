import "std/math.lx";

struct Point {
    x: i32,
    y: i32,
}

struct Rect {
    w: i32,
    h: i32,
}

fn multiply(a: i32, b: i32) -> i32 {
    return a * b;
}

fn main() -> i32 {
    let a: i32 = 10;
    let b: i32 = 3;
    print(a + b);
    print(a - b);
    print(a * b);
    print(a / b);
    print(-a);

    let big: i64 = 3000000000;
    print(big);
    let small: i32 = 5;
    let as_i64: i64 = small as i64;
    print(as_i64);

    let arr: [i32; 5] = [10, 20, 30, 40, 50];
    print(arr[0]);
    print(arr[4]);
    arr[2] = 99;
    print(arr[2]);

    let p: Point = Point { x: 3, y: 7 };
    print(p.x);
    print(p.y);
    p.x = 42;
    print(p.x);

    let r: Rect = Rect { w: 100, h: 50 };
    print(r.w);
    print(r.h);

    let val: i32 = 15;
    if val > 20 {
        print(1);
    } else if val > 10 {
        print(2);
    } else {
        print(3);
    }

    let i: i32 = 0;
    let sum: i32 = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);

    let total: i32 = 0;
    for j in 0..5 {
        total = total + j;
    }
    print(total);

    let t: bool = true;
    let f: bool = false;
    if (t and not f) {
        print(100);
    }
    if (f or t) {
        print(200);
    }

    let c1: i32 = 5;
    let c2: i32 = 10;
    if (c1 < c2) {
        print(11);
    }
    if (c1 <= c2) {
        print(12);
    }
    if (c2 > c1) {
        print(13);
    }
    if (c2 >= c1) {
        print(14);
    }
    if (c1 != c2) {
        print(15);
    }
    if (c1 == c1) {
        print(16);
    }

    print(multiply(6, 7));
    print(abs(-5));
    print(max(3, 8));
    print(min(3, 8));
    print(pow(2, 10));
    print(sum_to(10));
    print(clamp(15, 0, 10));

    print("done");

    return 0;
}
