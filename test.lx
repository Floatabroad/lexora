import "std/math.lx";

struct Point {
    x: i32,
    y: i32,
}

struct Rect {
    w: i32,
    h: i32,
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn fib(n: i32) -> i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i32 {
    print("== arithmetic ==");
    let a: i32 = 20;
    let b: i32 = 6;
    print(a + b);
    print(a - b);
    print(a * b);
    print(a / b);
    print(-a);

    print("== i64 + cast ==");
    let big: i64 = 5000000000;
    print(big);
    let al: i64 = a as i64;
    print(big + al);
    let roundtrip: i32 = al as i32;
    print(roundtrip);

    print("== bool + logic ==");
    let t: bool = true;
    let f: bool = false;
    print(t);
    print(f);
    print(t and f);
    print(t or f);
    print(not f);

    print("== comparisons ==");
    print(a > b);
    print(a < b);
    print(a >= a);
    print(a <= b);
    print(a == a);
    print(a != b);

    print("== str ==");
    let msg: str = "lexora";
    print(msg);

    print("== arrays ==");
    let arr: [i32; 5] = [1, 2, 3, 4, 5];
    print(arr[0]);
    print(arr[4]);
    arr[2] = 99;
    print(arr[2]);
    let asum: i32 = 0;
    for k in 0..5 {
        asum = asum + arr[k];
    }
    print(asum);

    print("== structs ==");
    let p: Point = Point { x: 10, y: 20 };
    print(p.x);
    print(p.y);
    p.x = 15;
    p.y = p.y + 5;
    print(p.x);
    print(p.y);
    let r: Rect = Rect { w: 4, h: 7 };
    print(r.w * r.h);

    print("== if / else ==");
    let n: i32 = 15;
    if n > 100 {
        print(1);
    } else if n > 10 {
        print(2);
    } else {
        print(3);
    }

    print("== while ==");
    let i: i32 = 0;
    let fact: i32 = 1;
    while i < 5 {
        i = i + 1;
        fact = fact * i;
    }
    print(fact);

    print("== for ==");
    let total: i32 = 0;
    for j in 1..11 {
        total = total + j;
    }
    print(total);

    print("== functions ==");
    print(add(33, 9));
    print(fib(10));

    print("== stdlib ==");
    print(abs(-42));
    print(max(7, 12));
    print(min(7, 12));
    print(pow(3, 4));
    print(sum_to(100));
    print(clamp(250, 0, 200));

    print("done");
    return 0;
}
