fn add(x: i32, y: i32) -> i32 {
      return x + y;
  }

  fn is_greater(x: i32, threshold: i32) -> bool {
      return x > threshold;
  }

  fn print_i64(n: i64) -> void {
      print(n);
  }
  fn main() -> i32 {
      print("=== i32 test ===");
      let x: i32 = 10;
      let y: i32 = 3;
      print(add(x, y));

      print("=== arithmetic ===");
      let product: i32 = x * y;
      let division: i32 = x / y;
      print(product);
      print(division);

      print("=== i64 test ===");
      let big: i64 = 9000000000;
      print_i64(big);

      print("=== bool and not ===");
      let b: bool = true;
      if not b {
          print("b is false");
      } else {
          print("b is true");
      }

      print("=== comparison ===");
      if is_greater(x, 5) {
          print("x is greater");
      } else {
          print("x is smaller");
      }

      print("=== and or ===");
      let a: bool = true;
      let c: bool = false;
      if a and not c {
          print("correct");
      }

      print("=== while ===");
      let i: i32 = 0;
      while i < 3 {
          print(i);
          i = i + 1;
      }

      print("=== for ===");
      for j in 0..4 {
          print(j);
      }

      print("=== str ===");
      let s: str = "lexora";
      print(s);
      print("direct string");

      print("=== parentheses ===");
      let result: i32 = (2 + 3) * 4;
      print(result);

    let n: i32 = 41;
    let h: i64 = n as i64;
    print_i64(h);

      return 0;
  }