enum D {
    A,
    B,
}

fn yut(s: String) -> i32 {
    len(s)
}

fn ayni_yol(c: bool) -> i32 {
    let s: String = string("a");
    if c {
        print(yut(s));
        return 1;
    }
    print(yut(s));
    print(len(s));
    return 0;
}

fn returnsuz(c: bool) -> i32 {
    let s: String = string("b");
    if c {
        print(yut(s));
    }
    print(len(s));
    return 0;
}

fn match_returnsuz(d: D) -> i32 {
    let s: String = string("c");
    match d {
        D::A => print(yut(s)),
        D::B => print(0)
    }
    print(len(s));
    return 0;
}

fn dongude(t: i32) -> i32 {
    let s: String = string("d");
    let i: i32 = 0;
    while i < t {
        print(yut(s));
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    return 0;
}
