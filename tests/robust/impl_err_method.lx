struct N { x: i32 }
enum E { A, B }
impl N {
    fn a(self) -> i32 { if self.x > 0 { self.x + } else { 0 } }
    fn b(self) -> i32 { match self.x { }
    fn c(self) -> i32 { self.x }
}
impl E { fn kod(self) -> i32 { match self { E::A => 1 E::B => 2 } } }
fn saglam(a: i32) -> i32 { return a + 1; }
fn main() -> i32 { let p: N = N { x: 1 }; return p.c() + saglam(2); }
