enum Shape { Circle(i32), Rect(i32, i32), Dot }
enum List { Cons(i32, Box<List>), Nil }

fn make(k: i32) -> Shape {
    if k == 0 { Shape::Circle(5) } else { Shape::Rect(3, 4) }
}

fn head(b: Box<List>) -> i32 {
    match *b {
        List::Cons(v, rest) => v,
        List::Nil => 0 - 1,
    }
}

fn sum(l: List) -> i32 {
    match l {
        List::Cons(v, rest) => v + sum(*rest),
        List::Nil => 0,
    }
}

fn main() -> i32 {
    let area: i32 = match make(0) {
        Shape::Circle(r) => r * r * 3,
        Shape::Rect(w, h) => w * h,
        Shape::Dot => 0,
    };
    print(area);
    print(match make(1) { Shape::Circle(r) => r, Shape::Rect(w, h) => w + h, Shape::Dot => 0 });
    print(head(box List::Cons(9, box List::Nil)));
    print(head(box List::Nil));
    print(sum(List::Cons(1, box List::Cons(2, box List::Cons(3, box List::Nil)))));
    return 0;
}
