enum List<T> { Cons(T, Box<List<T>>), Nil }

fn sum(l: List<i32>) -> i32 {
    match l {
        List::Cons(v, rest) => v + sum(*rest),
        List::Nil => 0,
    }
}

fn main() -> i32 {
    let l = List::Cons(1, box List::Cons(2, box List::Cons(3, box List::<i32>::Nil)));
    print(sum(l));
    0
}
