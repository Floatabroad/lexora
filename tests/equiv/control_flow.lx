fn classify(n: i32) -> i32 {
    if n < 0 {
        return 0;
    } else if n == 0 {
        return 1;
    } else {
        return 2;
    }
}

fn main() -> i32 {
    print(classify(-5));
    print(classify(0));
    print(classify(9));
    let i: i32 = 0;
    let s: i32 = 0;
    while i < 5 {
        s = s + i;
        i = i + 1;
    }
    print(s);
    for k in 0..4 {
        print(k);
    }
    return 0;
}
