enum Shape { Circle(i32), Rect(i32, i32), Dot }

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => { return r * r * 3; }
        Shape::Rect(w, h) => { return w * h; }
        Shape::Dot => { return 0; }
    }
}

fn main() -> i32 {
    print(area(Shape::Rect(3, 4)));
    print(area(Shape::Circle(5)));
    print(area(Shape::Dot));
    let s: Shape = Shape::Rect(2, 6);
    print(area(s));
    return 0;
}
