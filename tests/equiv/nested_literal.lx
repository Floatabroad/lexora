struct Inner { x: i32 }
struct Outer { i: Inner, n: i32 }
struct P { x: i32 }
struct T { s: String }

fn takes(p: P) -> i32 {
    return p.x;
}

fn sumarr(a: [i32; 3]) -> i32 {
    return a[0] + a[1] + a[2];
}

fn mkp() -> P {
    return P { x: 77 };
}

fn eat(t: T) -> i32 {
    return len(t.s);
}

fn eat2(a: [String; 2]) -> i32 {
    return len(a[0]) + len(a[1]);
}

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { x: 4 }, n: 5 };
    print(o.i.x);
    print(o.n);

    let m: [[i32; 2]; 2] = [[1, 2], [3, 4]];
    print(m[1][0]);
    print(m[0][1]);

    let deep: [[[i32; 2]; 2]; 2] = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
    print(deep[1][0][1]);

    print([10, 20, 30][1]);
    print(takes(P { x: 6 }));
    print(sumarr([7, 8, 9]));
    print(mkp().x);
    print(Inner { x: 12 }.x);

    print(eat(T { s: string("abc") }));
    print(eat2([string("de"), string("fghi")]));

    let t: i32 = 0;
    for k in 0..3 {
        t = t + takes(P { x: k });
    }
    print(t);
    return 0;
}
