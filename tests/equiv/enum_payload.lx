enum Shape {
    Circle(i32),
    Rect(i32, i32),
    Dot,
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => { return r * r * 3; }
        Shape::Rect(w, h) => { return w * h; }
        Shape::Dot => { return 0; }
    }
}

fn main() -> i32 {
    let c: Shape = Shape::Circle(10);
    let r: Shape = Shape::Rect(4, 5);
    let d: Shape = Shape::Dot;
    print(area(c));
    print(area(r));
    print(area(d));

    let big: Shape = Shape::Rect(100, 200);
    match big {
        Shape::Circle(x) => { print(1); }
        Shape::Rect(w, h) => { print(w + h); }
        _ => { print(999); }
    }
    return 0;
}
