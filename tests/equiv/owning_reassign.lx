struct K { a: String, b: String, n: i32 }
struct Ic { ad: String }
struct Dis { ic: Ic, s: i32 }
fn yut(s: String) -> i32 { return len(s); }
fn main() -> i32 {
    let k: K = K { a: string("ilk"), b: string("iki"), n: 1 };
    let m: String = k.a;
    k.a = string("yenilenmis");
    print(m);
    print(k.a);
    print(k.b);
    print(len(k.a));

    let s: String = string("bir");
    let t: String = s;
    s = string("ikinci");
    print(t);
    print(s);
    s = s + "!";
    print(s);

    let d: [String; 2] = [string("p"), string("qq")];
    d[0] = string("yeniP");
    print(d[0]);
    print(d[1]);

    let bx: Box<String> = box string("kutu");
    *bx = string("yenikutu");
    print(*bx);

    let o: Dis = Dis { ic: Ic { ad: string("derin") }, s: 3 };
    let z: String = o.ic.ad;
    o.ic.ad = string("derinyeni");
    print(z);
    print(o.ic.ad);

    let w: K = K { a: string("aa"), b: string("bb"), n: 2 };
    let q: String = w.a;
    w.a = string("geri");
    print(yut(q));
    print(w.a + w.b);
    return 0;
}
