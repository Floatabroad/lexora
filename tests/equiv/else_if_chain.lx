fn sec(x: i32) -> String {
    if x == 0 { string("s0") }
    else if x == 1 { string("s1") }
    else if x == 2 { string("s2") }
    else if x == 3 { string("s3") }
    else if x == 4 { string("s4") }
    else if x == 5 { string("s5") }
    else if x == 6 { string("s6") }
    else if x == 7 { string("s7") }
    else if x == 8 { string("s8") }
    else if x == 9 { string("s9") }
    else if x == 10 { string("s10") }
    else if x == 11 { string("s11") }
    else { string("son") }
}

fn kod(x: i32) -> i32 {
    if x < 0 { -1 }
    else if x < 10 { 1 }
    else if x < 100 { 2 }
    else if x < 1000 { 3 }
    else { 4 }
}

fn main() -> i32 {
    for i in 0..14 {
        let s: String = sec(i);
        print(s);
    }
    print(kod(-5));
    print(kod(3));
    print(kod(50));
    print(kod(500));
    print(kod(5000));
    let t: String = sec(3) + "-ek";
    print(t);
    return 0;
}
