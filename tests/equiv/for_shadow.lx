fn ver() -> i32 { return 4; }

fn main() -> i32 {
    let i: i32 = 3;
    for i in 0..i { print(i); }
    print(-1);
    for i in i..5 { print(i); }
    print(-2);
    let n: i32 = 2;
    for j in 0..n { for n in 0..n { print(n); } }
    print(-3);
    for k in 0..ver() { print(k); }
    print(-4);
    let t: i32 = 2;
    for t in t..t { print(t); }
    print(-5);
    let u: i32 = 1;
    for u in u..(u + 3) { print(u); }
    return 0;
}
