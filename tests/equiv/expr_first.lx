struct Point { x: i32, y: i32 }

fn getx(p: Point) -> i32 { p.x }

fn unbox(b: Box<i32>) -> i32 { *b }

fn main() -> i32 {
    let p: Point = Point { x: 11, y: 22 };
    print(getx(p));
    let b: Box<i32> = box 33;
    print(unbox(b));
    let arr: [i32; 3] = [5, 6, 7];
    arr[1];
    let m: i32 = 3;
    while m > 0 { m = m - 1; print(m) }
    for i in 0..2 { print(i + 10) }
    return 0;
}
