fn max(a: i32, b: i32) -> i32 {
    if a > b { a } else { b }
}

fn sign(x: i32) -> i32 {
    if x > 0 { 1 } else if x < 0 { 0 - 1 } else { 0 }
}

fn absval(x: i32) -> i32 {
    if x < 0 { return 0 - x; } else { return x; }
}

fn main() -> i32 {
    print(max(3, 7));
    print(sign(42));
    print(sign(0 - 5));
    print(sign(0));
    print(absval(0 - 9));
    let t: bool = true;
    let y: i32 = if t { let a: i32 = 5; a * 2 } else { 0 };
    print(y);
    let b: Box<i32> = if 1 < 2 { box 10 } else { box 20 };
    print(*b);
    return 0;
}
